+        const double value2 = x2[j] - x2[0];
+        rr[2] += qr[j] * value2; ri[2] += qi[j] * value2;
+        const double value3 = x3[j] - x3[0];
+        rr[3] += qr[j] * value3; ri[3] += qi[j] * value3;
+    }
+}
 
