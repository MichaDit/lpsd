+
+/* Real auto spectra have an exactly zero imaginary periodogram whenever
+ * their real power is finite. Keep the real Welford operations in their
+ * original order, avoiding the redundant complex arithmetic. Nonfinite
+ * powers or preceding means retain the full original exceptional path. */
+static LPSD_ALWAYS_INLINE void update_psd_statistics(long int ii, long int navg,
+                                        double real, double imag,
+                                        bool statistics, bool corrected,
+                                        double *Mr_r, double *Mr_i,
+                                        double *M2_r, double *M2_i)
+{
+    if (corrected) {
+        const double power = real * real - (-1.0 * imag) * imag;
+        if (isfinite(power) && isfinite(*Mr_r)) {
+            if (ii == 0) {
+                *Mr_r = power;
+                *Mr_i = 0.0;
+            } else {
+                const double difference = power - *Mr_r;
+                *Mr_r += difference / (double)(ii + 1);
+                if (statistics) {
+                    *M2_r += difference * (power - *Mr_r) + 0.0;
+                }
+            }
+            return;
+        }
+    }
+    update_statistics(ii, navg, real, imag, real, imag, statistics, corrected,
+                      Mr_r, Mr_i, M2_r, M2_i);
 }
 
